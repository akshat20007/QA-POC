[
  {
    "name": "Add product to cart and verify in cart page",
    "priority": "high",
    "category": "happy-path",
    "steps": [
      {
        "type": "given",
        "action": "navigate to login page",
        "target_hint": "url: /"
      },
      {
        "type": "when",
        "action": "fill username",
        "target_hint": "textbox: Username",
        "value": "standard_user"
      },
      {
        "type": "when",
        "action": "fill password",
        "target_hint": "textbox: Password",
        "value": "secret_sauce"
      },
      {
        "type": "when",
        "action": "click login button",
        "target_hint": "button: Login"
      },
      {
        "type": "when",
        "action": "click add to cart button for Sauce Labs Backpack",
        "target_hint": "button: Add to cart"
      },
      {
        "type": "then",
        "action": "assert cart badge shows 1",
        "target_hint": "testid: shopping-cart-badge",
        "value": "1"
      },
      {
        "type": "when",
        "action": "click cart icon",
        "target_hint": "testid: shopping-cart-link"
      },
      {
        "type": "then",
        "action": "assert product is listed in cart",
        "target_hint": "link: Sauce Labs Backpack"
      }
    ]
  },
