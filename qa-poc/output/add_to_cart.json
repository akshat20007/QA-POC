{
  "storyType": "ui",
  "testCases": [
    {
      "name": "Add product to cart and verify cart count and contents",
      "priority": "high",
      "category": "happy-path",
      "steps": [
        {
          "type": "given",
          "action": "navigate to login page",
          "target_hint": "url: /"
        },
        {
          "type": "when",
          "action": "fill username",
          "target_hint": "textbox: Username",
          "value": "standard_user"
        },
        {
          "type": "when",
          "action": "fill password",
          "target_hint": "textbox: Password",
          "value": "secret_sauce"
        },
        {
          "type": "when",
          "action": "click login button",
          "target_hint": "button: Login"
        },
        {
          "type": "when",
          "action": "click add to cart for backpack",
          "target_hint": "button: Add to cart"
        },
        {
          "type": "then",
          "action": "assert cart badge is visible",
          "target_hint": "shopping_cart_link"
        },
        {
          "type": "when",
          "action": "click cart icon",
          "target_hint": "shopping_cart_link"
        },
        {
          "type": "then",
          "action": "assert product is in cart",
          "target_hint": "link: Sauce Labs Backpack"
        }
      ]
    },
    {
      "name": "Toggle add to cart button to remove after adding product",
      "priority": "medium",
      "category": "happy-path",
      "steps": [
        {
          "type": "given",
          "action": "navigate to login page",
          "target_hint": "url: /"
        },
        {
          "type": "when",
          "action": "fill username",
          "target_hint": "textbox: Username",
          "value": "standard_user"
        },
        {
          "type": "when",
          "action": "fill password",
          "target_hint": "textbox: Password",
          "value": "secret_sauce"
        },
        {
          "type": "when",
          "action": "click login button",
          "target_hint": "button: Login"
        },
        {
          "type": "when",
          "action": "click add to cart for backpack",
          "target_hint": "button: Add to cart"
        },
        {
          "type": "then",
          "action": "assert button text changes to remove",
          "target_hint": "button: Remove"
        }
      ]
    },
