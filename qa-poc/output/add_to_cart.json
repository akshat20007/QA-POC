          "target_hint": "button: Login"
        },
        {
          "type": "when",
          "action": "click add to cart for backpack",
          "target_hint": "button: Add to cart"
        },
        {
          "type": "when",
          "action": "click add to cart for bike light",
          "target_hint": "button: Add to cart"
        },
        {
          "type": "then",
          "action": "assert cart badge shows two items",
          "target_hint": "shopping_cart_link"
        }
